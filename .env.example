# 开发环境示例。复制为 .env 后按需修改；桌面版通常不需要此文件。
# development 会在 API 错误中附带调试细节；正式运行可改为 production。
NODE_ENV=development

# 服务端口
PORT=3000

# yt-dlp 可执行文件名或绝对路径（默认从 PATH 查找）
# Windows 示例: YT_DLP_BINARY=C:/Tools/yt-dlp.exe
YT_DLP_BINARY=yt-dlp

# ffmpeg 可执行文件名或绝对路径（混流/转码需要）
FFMPEG_BINARY=ffmpeg

# 单次解析的超时时间（毫秒）。大播放列表建议调大。
RESOLVE_TIMEOUT_MS=60000

# 默认下载根目录。桌面版优先使用“设置”页面中保存的值。
DOWNLOAD_PATH=./downloads

# 最大并发下载数（建议 1-3，过高可能触发 YouTube 风控）
MAX_CONCURRENT=2

# 文件命名模板
# 可用变量: {course} {date} {num} {title} {quality} {ext}
NAMING_TEMPLATE={course}/{date}_{num}_{title}.{ext}

# 以下是开发/部署路径。普通本地开发保持默认即可。
APP_DATA_PATH=.
APP_RESOURCE_PATH=.

# SQLite 数据库文件路径
DB_PATH=./data/app.db

# 前端生产构建目录
WEB_DIST_PATH=./dist/client
