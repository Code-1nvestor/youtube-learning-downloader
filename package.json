{
  "name": "youtube-learning-downloader",
  "version": "0.23.0",
  "private": true,
  "main": "desktop/main.cjs",
  "description": "YouTube 学习资料下载工具（个人学习用途，非商业）",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --experimental-sqlite node_modules/tsx/dist/cli.mjs watch server/index.ts",
    "start": "node --experimental-sqlite node_modules/tsx/dist/cli.mjs server/index.ts",
    "build:client": "npm --prefix client run build",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:client && npm run build:server",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder --win nsis portable",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-sqlite node_modules/tsx/dist/cli.mjs --test tests/**/*.test.ts",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "ui:fixture": "node scripts/ui-fixture-server.mjs",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "com.local.youtubelearningdownloader",
    "productName": "学习资料下载器",
    "asar": true,
    "beforeBuild": "scripts/skip-electron-dependency-rebuild.cjs",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "app": "desktop",
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "download-actions.cjs",
      "close-guard.cjs",
      "task-monitor.cjs",
      "data-backup.cjs",
      "app-restart.cjs",
      "diagnostics.cjs",
      "release-policy.cjs",
      "icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/server",
        "to": "server"
      },
      {
        "from": "dist/client",
        "to": "client"
      },
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "win": {
      "icon": "desktop/icon.ico",
      "signExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
